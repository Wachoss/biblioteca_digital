# Copia este fichero a .env y ajústalo. El .env no se sube a Git.
BIBLIOTECA_DATABASE_URL=sqlite:///biblioteca.db

# Inicio de sesión del dueño. Genera ambas líneas con: uv run python -m app.auth
# BIBLIOTECA_OWNER_PASSWORD_HASH='$argon2id$...'
# BIBLIOTECA_SECRET_KEY='...'
# Con HTTPS (en producción), para que la cookie de sesión no viaje nunca sin cifrar:
# BIBLIOTECA_SESSION_HTTPS_ONLY=true
